{
  "name": "tsnv",
  "version": "0.0.0",
  "description": "Modern build toolkit for React Native libraries",
  "license": "MIT",
  "author": "Geunhyeok Lee <dev.ghlee@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leegeunhyeok/tsnv.git",
    "directory": "."
  },
  "bin": "bin.js",
  "workspaces": [
    "example"
  ],
  "files": [
    "bin.js",
    "dist"
  ],
  "type": "module",
  "main": "./dist/config.cjs",
  "module": "./dist/config.js",
  "types": "./dist/config.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepack": "yarn build",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --deny-warnings --fix",
    "fmt": "oxfmt",
    "test": "vitest --run",
    "test:e2e": "vitest --run --config vitest.e2e.config.ts",
    "test:all": "yarn test && yarn test:e2e",
    "build": "tsdown",
    "scripts:version": ".scripts/version.sh",
    "scripts:publish": ".scripts/publish.sh"
  },
  "dependencies": {
    "c12": "^3.3.4",
    "empathic": "^2.0.1",
    "es-toolkit": "^1.50.0",
    "get-tsconfig": "^4.14.2",
    "obug": "^2.1.4",
    "package-manager-detector": "^1.8.0",
    "picocolors": "^1.1.1",
    "rolldown": "1.2.4",
    "rolldown-plugin-dts": "0.28.2",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "strip-ansi": "^7.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zx": "^8.8.5"
  },
  "dependenciesMeta": {
    "oxfmt": {
      "unplugged": true
    },
    "oxlint": {
      "unplugged": true
    },
    "oxlint-tsgolint": {
      "unplugged": true
    }
  },
  "peerDependencies": {
    "@typescript/native-preview": "*",
    "typescript": "*"
  },
  "peerDependenciesMeta": {
    "@typescript/native-preview": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "yarn@4.18.0"
}
