{
  "printWidth": 100,
  "singleQuote": true,
  "sortImports": {
    "groups": [
      ["type-import"],
      ["type-builtin", "value-builtin"],
      ["type-external", "value-external", "type-internal", "value-internal"],
      ["type-parent", "type-sibling", "type-index", "value-parent", "value-sibling", "value-index"],
      ["unknown"]
    ]
  }
}
